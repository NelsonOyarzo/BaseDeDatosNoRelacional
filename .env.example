# Copiar este archivo como .env (el .env no se sube al repositorio) y completar la URI.
# Las variables de entorno del sistema tienen prioridad sobre este archivo.
MONGO_URI=mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/
MONGO_DB=QuickTrack

# Opcionales (valores por defecto)
# MONGO_TIMEOUT_MS=5000
# API_HOST=127.0.0.1
# API_PUERTO=8000
# API_NIVEL_LOG=INFO
# API_CORS_ORIGENES=*
